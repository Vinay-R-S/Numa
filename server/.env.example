# ===== SUPABASE / POSTGRESQL =====
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Pool sizing. Callers queue up to DB_POOL_TIMEOUT seconds for a free
# connection, so DB_POOL_MAX bounds concurrent DB work rather than failing it.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===== JWT =====
JWT_SECRET=your-strong-random-secret

# ===== APP URLS =====
FRONTEND_URL=http://localhost:3000

# development | production. Anything other than "development" is treated as
# production: CORS then allows only FRONTEND_URL, and allows nothing at all if
# that is unset. Set this to development for local work so devices on your LAN
# (a phone on the same wifi) can reach the API.
NUMA_ENV=development

BACKEND_URL=http://localhost:8000

# ===== GOOGLE CALENDAR =====
# Public HTTPS base URL Google posts push notifications to. Unset (the local
# default) means no watch channel is registered and the calendar falls back to
# polling.
GOOGLE_WEBHOOK_BASE_URL=

# Shared secret Google echoes back as X-Goog-Channel-Token on every push. The
# webhook has no JWT, so this is what authenticates it. Optional: unset, each
# watch registers a per-process token instead, which does not survive a restart
# or match across workers. Set it to a random string in production.
WATCH_WEBHOOK_TOKEN=

GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/calendar/oauth/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:3000/calendar
GOOGLE_CALENDAR_CREDENTIALS_FILE=/path/to/google_web_oauth_client.json
GOOGLE_CALENDAR_TOKEN_DIR=/path/to/token/directory

# ===== GOOGLE FIT =====
GOOGLE_FIT_CLIENT_ID=your-google-fit-client-id
GOOGLE_FIT_CLIENT_SECRET=your-google-fit-client-secret
GOOGLE_FIT_CREDENTIALS_FILE=credentials.json
GOOGLE_FIT_TOKEN_FILE=D:/Numa/server/apiConfig/google/tokens/google_fit_token.json

# ===== SLACK =====
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Required whenever any other SLACK_* credential is set: it is the only thing
# authenticating POST /slack/events. Without it the server refuses every event,
# and refuses to start at all if Slack is configured. Basic Information ->
# Signing Secret at https://api.slack.com/apps.
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://your-domain/slack/callback
SLACK_MESSAGE_RETENTION_DAYS=7
NGROK_AUTHTOKEN=your-ngrok-auth-token

# ===== GITHUB =====
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/callback

# ===== STRAVA =====
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret
STRAVA_REFRESH_TOKEN=your-strava-refresh-token
STRAVA_TOKEN_FILE=D:/Numa/server/apiConfig/strava/token.json
REDIRECT_URI=http://localhost:8501

# ===== LLM PROVIDERS =====
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MASTER_MODEL=llama-3.3-70b-versatile
GROQ_MASTER_TEMPERATURE=0.1
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_API_KEY=your-gemini-api-key

# ===== QDRANT VECTOR DATABASE =====
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_URL_ENDPOINT=https://your-cluster.cloud.qdrant.io

# ===== EMBEDDINGS =====
EMBEDDING_PROVIDER=local
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ===== ENCRYPTION =====
# Fernet key for the per-user API keys stored in user_ai_settings. Must be 32
# url-safe base64-encoded bytes; the server refuses to start otherwise. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored API key unreadable, so users must re-enter them.
NUMA_ENCRYPTION_KEY=paste-a-generated-fernet-key-here

# ===== ADMIN =====
# Comma-separated emails allowed to change server-wide integration keys
# (PUT /ai-settings/integration-keys, which rewrites this file). Leave it empty
# and nobody can: the endpoint fails closed. Per-user provider/model/API-key
# settings are unaffected - any signed-in user still manages their own.
NUMA_ADMIN_EMAILS=you@example.com

# ===== MISC =====
TIMEZONE=Asia/Kolkata
SYNC_SCHEDULER_INTERVAL_MINUTES=30
LEETCODE_USERNAME=your-leetcode-username
